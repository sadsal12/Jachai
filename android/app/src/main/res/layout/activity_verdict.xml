<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/verdict_loading">

    <!-- Loading -->
    <LinearLayout
        android:id="@+id/loading_group"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:id="@+id/loading_icon"
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/accent"
            android:importantForAccessibility="no"
            android:padding="30dp"
            android:src="@drawable/ic_shield_check"
            app:tint="@color/on_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/loading_title_bn"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading_title_en"
            android:textColor="@color/on_verdict_secondary"
            android:textSize="20sp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:indeterminate="true"
            app:indicatorColor="@color/accent"
            app:trackColor="#33FFFFFF"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp" />

        <TextView
            android:id="@+id/loading_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:minLines="2"
            android:textColor="@color/on_verdict_secondary"
            android:textSize="17sp"
            tools:text="পরিচিত গুজবের সাথে মেলানো হচ্ছে…\nChecking against known hoaxes…" />
    </LinearLayout>

    <!-- Result / error -->
    <LinearLayout
        android:id="@+id/result_group"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <!-- Hero: the answer, readable at a glance -->
                <LinearLayout
                    android:id="@+id/hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="28dp"
                    android:paddingTop="36dp"
                    android:paddingEnd="28dp"
                    android:paddingBottom="64dp"
                    tools:backgroundTint="@color/verdict_red">

                    <ImageView
                        android:id="@+id/verdict_icon"
                        android:layout_width="132dp"
                        android:layout_height="132dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="#33FFFFFF"
                        android:contentDescription="@null"
                        android:padding="14dp"
                        tools:src="@drawable/ic_verdict_fake" />

                    <TextView
                        android:id="@+id/verdict_title_bn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center"
                        android:textColor="@android:color/white"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        tools:text="সম্ভবত ভুয়া / এআই-তৈরি" />

                    <TextView
                        android:id="@+id/verdict_title_en"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:textColor="@color/on_verdict_secondary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="Likely fake / AI-generated" />
                </LinearLayout>

                <!-- How sure: words first, number second -->
                <LinearLayout
                    android:id="@+id/certainty_card"
                    style="@style/Card"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="-40dp"
                    android:layout_marginEnd="20dp"
                    android:elevation="6dp">

                    <TextView
                        style="@style/Text.Muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/how_sure" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/certainty_word"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_primary"
                            android:textSize="21sp"
                            android:textStyle="bold"
                            tools:text="খুবই নিশ্চিত · Very sure" />

                        <TextView
                            android:id="@+id/confidence_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_muted"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            tools:text="87%" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/confidence_bar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="14dp"
                        android:layout_marginTop="12dp"
                        android:max="100"
                        android:progressDrawable="@drawable/confidence_meter"
                        tools:progress="87" />
                </LinearLayout>

                <!-- What to do -->
                <LinearLayout
                    android:id="@+id/advice_card"
                    style="@style/Card"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="20dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/advice_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:importantForAccessibility="no"
                        tools:src="@drawable/ic_warning" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Heading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/advice_title" />

                        <TextView
                            android:id="@+id/advice"
                            style="@style/Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            tools:text="এটি ফরোয়ার্ড করবেন না।\nDon't forward this." />
                    </LinearLayout>
                </LinearLayout>

                <!-- Why -->
                <LinearLayout
                    android:id="@+id/why_card"
                    style="@style/Card"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="20dp">

                    <TextView
                        android:id="@+id/why_title"
                        style="@style/Text.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/why_title" />

                    <TextView
                        android:id="@+id/explanation_bn"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        tools:text="এই ছবিতে এআই দিয়ে তৈরি বা কারসাজির লক্ষণ পাওয়া গেছে।" />

                    <TextView
                        android:id="@+id/explanation_en"
                        style="@style/Text.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        tools:text="Signs of AI generation or manipulation were found in this image." />

                    <TextView
                        android:id="@+id/detail"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_field"
                        android:padding="14dp"
                        android:textSize="16sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Lets the user reply to the rumour in the chat it came from -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_share"
                    style="@style/Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="20dp"
                    android:minHeight="64dp"
                    android:text="@string/btn_share"
                    android:visibility="gone"
                    app:icon="@drawable/ic_share" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/button_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_retry"
                style="@style/Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:minHeight="64dp"
                android:text="@string/btn_retry"
                android:visibility="gone"
                app:icon="@drawable/ic_refresh" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_done"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_done" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
