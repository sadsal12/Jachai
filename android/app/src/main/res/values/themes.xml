<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One theme for both modes: the colour roles point at resources that values-night/colors.xml overrides. -->
    <style name="Theme.Jachai" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSecondaryContainer">@color/accent_soft</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_muted</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="materialButtonStyle">@style/Button.Primary</item>
    </style>

    <!-- Launcher splash: charcoal + shield icon, then hands over to the normal theme. -->
    <style name="Theme.Jachai.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/icon_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Jachai</item>
    </style>

    <!-- Starts on the loading colour so there's no white flash when launched from the share sheet. -->
    <style name="Theme.Jachai.Verdict" parent="Theme.Jachai">
        <item name="android:windowBackground">@color/verdict_loading</item>
    </style>
</resources>
