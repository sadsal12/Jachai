<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Type scale: body never below 16sp; everything also scales with the in-app text size setting. -->
    <style name="Text.Title" parent="">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Heading" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Text.Muted" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Text.Section" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="Card" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">20dp</item>
    </style>

    <style name="Page" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:fillViewport">true</item>
        <!-- Leaves room for the floating nav bar. -->
        <item name="android:paddingBottom">@dimen/nav_clearance</item>
    </style>

    <!-- Buttons: big targets, rounded, accent fill with charcoal text (about 8:1 contrast). -->
    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">64dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="iconSize">26dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
    </style>

    <style name="Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">58dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="iconSize">24dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
    </style>

    <style name="Button.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">58dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="backgroundTint">@color/segment_bg</item>
        <item name="strokeColor">@color/outline</item>
        <item name="iconTint">@color/segment_text</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">22dp</item>
    </style>
</resources>
