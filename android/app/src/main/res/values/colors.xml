<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- V2 palette, light mode. Dark mode overrides the surface/text roles in values-night/colors.xml. -->
    <color name="accent">#8CA8F9</color>
    <color name="on_accent">#1A1B22</color>
    <color name="bg">#F8F9FA</color>
    <color name="surface">#FFFFFF</color>
    <color name="nav_bg">#FFFFFF</color>
    <color name="field_bg">#F1F3F7</color>
    <color name="accent_soft">#E7EDFE</color>
    <color name="text_primary">#1A1B22</color>
    <color name="text_muted">#5B6170</color>
    <color name="outline">#DDE1E8</color>

    <color name="status_ok">#2E7D32</color>
    <color name="status_wait">#E0A100</color>
    <color name="status_bad">#C62828</color>

    <!-- Verdict colours: they fill the result hero, so they stay the same in both modes. -->
    <color name="verdict_red">#C62828</color>
    <color name="verdict_green">#2E7D32</color>
    <color name="verdict_loading">#1A1B22</color>
    <color name="verdict_neutral">#455A64</color>
    <color name="on_verdict_secondary">#E6FFFFFF</color>

    <!-- App icon (B3). Night versions flip to a light tile so it stays visible on dark surfaces. -->
    <color name="icon_bg">#FFFFFF</color>
    <color name="icon_tile">#111111</color>
    <color name="icon_mark">#FFFFFF</color>

    <color name="brand">#1A1B22</color>
</resources>
